NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Staff sign-in (Better Auth, web/lib/auth.ts). Postgres connection for schema auth_ba: the project's direct or
# session-pooler connection string (Supabase → Connect). Local: postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_URL=
# 32+ random bytes, e.g. `openssl rand -base64 32`. Signs cookies and encrypts authenticator secrets: never rotate casually.
BETTER_AUTH_SECRET=
# The app's public origin, e.g. https://ichido.example.jp (local: http://localhost:3000). Cookies, links and passkeys use it.
BETTER_AUTH_URL=
# optional: more exact origins allowed to call /api/auth with cookies, comma-separated (passkeys accept them too)
AUTH_TRUSTED_ORIGINS=
# WebAuthn relying party id: the registrable domain passkeys belong to, e.g. ichido.example.jp (local: localhost).
# Defaults to BETTER_AUTH_URL's host. Changing it later invalidates every registered passkey.
PASSKEY_RP_ID=
# The project's JWT secret (Supabase → Project Settings → JWT; local: `supabase status` JWT_SECRET). Signs the
# five-minute database token for staff (/api/auth/supabase-token) so PostgREST and Realtime apply RLS.
SUPABASE_JWT_SECRET=
# Account email (invites, verification, password reset, sign-in codes, new-device alerts)
# Production: Brevo transactional API key (Brevo → SMTP & API → API keys). The sender must be a verified Brevo sender.
BREVO_API_KEY=
MAIL_FROM=Ichido <no-reply@example.jp>
# Development only, without BREVO_API_KEY: a local Mailpit (`docker run -d --name ichido-mailpit -p 1025:1025 -p 8025:8025 axllent/mailpit`)
MAILPIT_URL=http://127.0.0.1:8025
# {"TABLE-A":"<long random secret>"} — each ESP32 Help Point sends its station's secret as a bearer token
DEVICE_SECRETS_JSON=
# optional: without it, callers set facts with on-screen choices
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-terra
# optional: Gemini decision support for operators (function calling over the case; never writes to callers)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-4-hydrogen
# optional: model API base URLs (default the official endpoints); tests point them at tests/ai-stub.mjs
OPENAI_BASE_URL=
GEMINI_BASE_URL=
# optional: this app's public https origin; when set, Ask Ichido lets OpenAI call /api/mcp as a remote MCP server
ICHIDO_PUBLIC_URL=
# optional: Ichido Bot reminders fire after this share of each response target (ichido.sla_target); default 0.75
BOT_REMIND_AT=
# optional, tests only: seconds in one promised minute (call-backs, guard estimates); default 60
PROMISE_MINUTE_S=
# optional: voice
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Shared with the agent: signs the text it may speak
AGENT_BRIDGE_SECRET=
AGENT_NAME=ichido-intake
# optional: Better Stack logs (Telemetry → Sources → your HTTP source). Without them, logs go to stdout only.
BETTERSTACK_SOURCE_TOKEN=
# the source's ingesting host, e.g. s1234567.eu-nbg-2.betterstackdata.com
BETTERSTACK_INGEST_HOST=
# optional: {"TABLE-A":"https://uptime.betterstack.com/api/v1/heartbeat/<id>"} — pinged at most once a minute per
# station while its Help Point sends heartbeats (docs/DEPLOY.md section 5)
BETTERSTACK_HEARTBEATS_JSON=
# optional: staff Web Push (docs/DEPLOY.md section 6). Generate with: node scripts/vapid-keys.mjs mailto:<ops inbox>
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# optional: Expo push access token, only if the Expo project enforces push security
EXPO_ACCESS_TOKEN=
# optional: bearer secret for GET /api/alerts/flush (a once-a-minute scheduler delivers SLA alerts with no Help Points online)
CRON_SECRET=
# optional: signed Help Point firmware manifest, the output of scripts/sign-firmware.mjs. Empty = no update offered.
FIRMWARE_MANIFEST_JSON=
# Disaster feeds (JMA + P2PQuake): /api/cron/disaster runs only with this bearer. Vercel Cron sends it; locally
# `npm run feeds` polls the dev server with it every minute. Any long random string (openssl rand -hex 32).
CRON_SECRET=
# set by Vercel automatically; shown in /api/health and every log line
# VERCEL_GIT_COMMIT_SHA=
