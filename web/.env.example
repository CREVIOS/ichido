NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# {"TABLE-A":"<long random secret>"} — each ESP32 Help Point sends its station's secret as a bearer token
DEVICE_SECRETS_JSON=
# optional: without it, callers set facts with on-screen choices
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-terra
# optional: Gemini decision support for operators (function calling over the case; never writes to callers)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-4-hydrogen
# optional: voice
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Shared with the agent: signs the text it may speak
AGENT_BRIDGE_SECRET=
AGENT_NAME=ichido-intake
# optional: Better Stack logs (Telemetry → Sources → your HTTP source). Without them, logs go to stdout only.
BETTERSTACK_SOURCE_TOKEN=
# the source's ingesting host, e.g. s1234567.eu-nbg-2.betterstackdata.com
BETTERSTACK_INGEST_HOST=
# optional: {"TABLE-A":"https://uptime.betterstack.com/api/v1/heartbeat/<id>"} — pinged on each device heartbeat
BETTERSTACK_DEVICE_HEARTBEATS_JSON=
# set by Vercel automatically; shown in /api/health and every log line
# VERCEL_GIT_COMMIT_SHA=
