# Copy to .env (git-ignored). Values come from `supabase status` and the web app origin.
# iOS simulator: 127.0.0.1 / localhost reach the Mac. Android emulator: use 10.0.2.2. Physical phone: the Mac's LAN IP.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Web app origin that serves /api/cmd and /api/livekit/token (an https origin also becomes the Help Point link host)
EXPO_PUBLIC_API_URL=http://localhost:3000
