LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Speech-to-text: Soniox (console.soniox.com → API keys)
SONIOX_API_KEY=
SONIOX_MODEL=stt-rt-v6
# Text-to-speech: ElevenLabs, your own key (elevenlabs.io → Developers → API keys)
ELEVEN_API_KEY=
# eleven_v4_turbo speaks Bengali; eleven_flash_v2_5 does not
ELEVEN_MODEL=eleven_v4_turbo
# Optional voice ids per language (default: ElevenLabs stock voice hpp4J3VqNfWAUOO0d1Us for all three)
ELEVEN_VOICE_BN=
ELEVEN_VOICE_EN=
ELEVEN_VOICE_JA=
AGENT_NAME=ichido-intake
# Background voice cancellation (BVC) is licensed through LiveKit Cloud. Set to "off" on a self-hosted LiveKit server.
NOISE_CANCELLATION=bvc
# Same value as in the web app: the agent speaks only text signed with it
AGENT_BRIDGE_SECRET=
# optional: Better Stack logs (a separate HTTP or Python source is clearest). Without the token, stdout only.
BETTERSTACK_SOURCE_TOKEN=
BETTERSTACK_INGEST_HOST=
